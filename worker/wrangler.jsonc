{
  "name": "jt-workbench",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "jt.410518072.xyz", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jt_workbench",
      "database_id": "bf39be4c-4051-47ae-a2d9-f00775964152"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "jt-workbench"
    }
  ]
}
