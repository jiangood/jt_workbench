{
  "name": "workbench-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run scripts:build && wrangler dev",
    "deploy": "node scripts/guard-deploy.mjs && npm run scripts:build && wrangler deploy",
    "deploy:dry": "npm run scripts:build && wrangler deploy --dry-run",
    "check": "tsc --noEmit",
    "scripts:build": "node scripts/build-agent-scripts.mjs"
  },
  "dependencies": {
    "croner": "^8.0.0",
    "hono": "^4.6.0",
    "solarlunar": "^3.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261110.1": true
  }
}
